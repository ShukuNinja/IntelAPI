APP_NAME=API Intelligence Platform API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://api_app:replace-this-local-password@localhost:5432/api_intelligence
ALLOW_LOCAL_TARGETS=true
ALLOW_PRIVATE_NETWORK_TARGETS=false
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_MAX_RESPONSE_BYTES=2000000
